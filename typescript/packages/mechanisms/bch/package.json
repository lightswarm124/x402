{
  "name": "@x402/bch",
  "version": "2.27.0",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.mts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint:check": "eslint src test --ext .ts"
  },
  "keywords": [
    "x402",
    "payment",
    "protocol",
    "bitcoin-cash",
    "bch"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/x402-foundation/x402",
  "description": "Bitcoin Cash exact payment mechanism for x402",
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@noble/hashes": "^1.8.0",
    "@x402/core": "workspace:~"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-sonarjs": "^3.0.7",
    "prettier": "3.5.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.6",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./exact/client": {
      "import": {
        "types": "./dist/esm/exact/client/index.d.mts",
        "default": "./dist/esm/exact/client/index.mjs"
      }
    },
    "./exact/server": {
      "import": {
        "types": "./dist/esm/exact/server/index.d.mts",
        "default": "./dist/esm/exact/server/index.mjs"
      }
    },
    "./exact/facilitator": {
      "import": {
        "types": "./dist/esm/exact/facilitator/index.d.mts",
        "default": "./dist/esm/exact/facilitator/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ]
